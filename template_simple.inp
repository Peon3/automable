# This will be template inputfile for dave simplified for testing
# input is CaSe InSeNsItIvE

Settings
    func    b3lyp bp86 tpssh pbe0   # default
    basis   def2-tzvp(-f) AutoAux   # default
    corr    d3bj                    # default
    memory  bold                   # bold default
    UKS     True                    # default
    CPCM    False                   # default
End

Roadmap
    Geom        # Freq is included automatically in every step where it should be done, like geom, after neb, after optts, and after irc
End

Init
    Geom
        Block   1-10
        Charge  0,1
        Mult    1,2
    End
    Geom
        Block   11-20
        Charge  3
        Mult    12
    End
End