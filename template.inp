# This will be template inputfile for dave
# input is CaSe InSeNsItIvE

Settings
    func    b3lyp bp86 tpssh pbe0   # default
    basis   def2-tzvp(-f) AutoAux   # default
    corr    d3bj                    # default
    memory  bold/conservative       # bold default
    UKS     True                    # default
    CPCM    False                   # default
End

CPCM
    Solv        ACN
    Epsilon     12
    Refrac      12
End

Roadmap
    Geom        # Freq is included automatically in every step where it should be done, like geom, after neb, after optts, and after irc
    NEB
    OptTS
    IRC
    CC
    Properties
End

Init
    GeomBlock   1-10
        Charge  0,1
        Mult    1,2
    End
    GeomBlock   11-20
        Charge  3
        Mult    12
    End
End

Geom
    ?
End

NEB
    Mode    TS 
            CI      # default
    Zoom    True    # default 
            False
End

OptTS
    ?
End

IRC
    ?
End

CC
    PNOlevel    Tight   # default
                Normal
                Loose   # do not if not for good reason
    CCbasis     cc-pvtz # default
End

Properties
    Moess   True
            False   # default
    UVVIS  True
            False   # default
    K-edge  True
            False   # default
    RRaman  True
            False   # default
End

Moess
    Diligence   3   # level of, how many fits/calcs are utilized to enshure validity of results
                2   # default
                1
    Fit1        qzvp-fit    # default order, can be changed by assigning
    Fit2        zora-fit
    Fit3        cppp-fit
End

UVVis
    nroots      20          # default
    functional  cam-b3lyp   # default
    eVrange                 # experimental
                True        
                False       # default
        bound   5           # eV
End

K-edge                  # TDDFT based
    Functionals
        cam-b3lyp   True    # default
        wB97X-D4    False   # default
        pbe0        False   # default
End                     # other informations will be asked for when that point of the project is reached

RRaman
    Shift-Element   O       # default
    Conflict        False   # default # if there is other atoms of the same element in the geometry.
End